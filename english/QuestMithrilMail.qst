      <Success first="yes">All 4 mines have now been cleared.</Success>
      <Success first="no">Alas, this mine has already been cleared out.  The Dwarves decide not to give you the Mithril Mail.</Success>
      <Reward type="item" data="74">With all the mines cleared out, the Dwarves are grateful, and they give you the Mithril Mail as promised.</Reward>
      <Monster type="50" number="1" level="15"/>
      <Monster type="43" number="4" level="1"/>
   </Part>
</Quest>
