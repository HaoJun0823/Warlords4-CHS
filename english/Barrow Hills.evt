		<Unit id="1" type="28" level="8" name="Farix"/>
		<Unit id="2" type="29" level="9" name="Durk"/>
	</Warlord>


	<Ruin id="0" available_for_quest="no">
		<Heading>Barrow Wight</Heading>
		<Message>This barrow contains the treasure of an ancient hero - a shining magical sword.</Message>
		<Monster type="30" number="1" level="16"/>
		<Reward type="item" data="48"/>
	</Ruin >

