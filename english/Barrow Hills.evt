	<Ruin id="5" available_for_quest="no">
		<Heading>Harpy Hag</Heading>
		<Message>The Harpy seems to have collected a number of books.  Many of them are ancient texts containing much wisdom.</Message>
		<Monster type="40" number="1" level="8"/>
		<Reward type="xp" data="10"/>
	</Ruin >

	<Event side="0" repeat="1">
		<Trigger type="on_turn"/>
		<Trigger type="turn" data1="1"/>
		<Message>Your King has given you a mission - expand his lands to the north in the Barrow Hills by wiping out the Orkish and Imperial forces there.|These Barrow Hills are rumored to be haunted. Even without ghosts and spirits, your foes will be difficult enough to conquer.  To this end the King will periodically supply you with reinforcements and gold.</Message>
	</Event>

	<Event side="0" repeat="0" location="capital">
		<Trigger type="on_turn"/>
		<Trigger type="turn_or_later" data1="4"/>
		<Trigger type="chance" data1="20"/>
		<Message>Reinforcements arrive! | 4 Knights arrive at your capital, sent by the King himself, bearing 300 Gold coins.</Message>
		<Action type="gold" data1="300"/>
		<Action type="unit" data1="2" data2="4" data3="2"/>
	</Event>

	<Event side="0" repeat="1">
		<Trigger type="on_turn"/>
		<Trigger type="turn" data1="2"/>
		<Message>You are learning many things about these lands.  Rumor has it that many old kings are buried here in the Southern Hills - hidden away in dark barrows.</Message>
	</Event>



	<Event side="0" repeat="1">
		<Trigger type="on_turn"/>
		<Trigger type="turn" data1="3"/>
		<Message>Today you heard a new rumor!  The people here tell of a legend that four pieces of Shining armor can be found in the Barrow Hills.  They say that he who wears them will control a legion of Undead!</Message>
	</Event>

	<Event side="0" repeat="1" location="ruin" locdata="0">
		<Trigger type="on_ruin"/>
		<Trigger type="ruin_searched" data1="0"/>
		<Action type="counter_add" data1="1" string1="shiny_counter"/>
	</Event>

