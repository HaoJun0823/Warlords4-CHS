<Quest name="Raising Ghuulgorak">
   <Part id="0">
      <Description done="no">If you gather the skulls of 3 ancient Dragons you can raise a mighty Dragonliche.  First seek the Lord of Swamps. Location: %s.</Description>
      <Description done="yes" first="yes">You have slain the Lord of Swamps and obtained his skull.</Description>
      <Description done="yes" first="no">The first Ancient Dragon was already dead when you found him, but you retrieved his skull.</Description>
      <Success first="yes">You have slain the first Ancient Dragon and taken his skull.</Success>
      <Success first="no">The first Dragon is already dead, but his skull is still intact.</Success>
      <Reward type="gold" data="3542">This Dragon also had a massive treasure worth 3542 gold.</Reward>
      <Monster type="49" number="1" level="12" name="Lord of Swamps"/>
      <Monster type="18" number="7" level="3"/>
   </Part>
   <Part id="1">
      <Description done="no">To raise the Dragonliche, you must now seek and slay the Lord of Storms. Location: %s.</Description>
      <Description done="yes" first="yes">You have slain the Lord of Storms and obtained his skull.</Description>
      <Description done="yes" first="no">The second Ancient Dragon was already dead when you found him, but you retrieved his skull.</Description>
      <Success first="yes">You have slain the second Ancient Dragon and taken his skull.</Success>
      <Success first="no">The second Dragon is already dead, but his skull is still intact.</Success>
      <Reward type="item" data="48">In this Dragon&apos;s treasure horde you find a magical sword - the Stormblade.</Reward>
      <Monster type="50" number="1" level="13" name="Lord of Storms"/>
      <Monster type="24" number="7" level="2"/>
   </Part>
   <Part id="2">
      <Description done="no">To raise the Dragonliche, you must now seek and slay the Lord of Flame. Location: %s.</Description>
      <Description done="yes" first="yes">You have slain the Lord of Flame and obtained his skull.</Description>
      <Description done="yes" first="no">The third Ancient Dragon was already dead when you found him, but you retrieved his skull.</Description>
      <Success first="yes">You have slain the third Ancient Dragon and taken his skull.</Success>
      <Success first="no">The third Dragon is already dead, but his skull is still intact.</Success>
      <Reward type="mana" data="3">This Dragon also had a cache of 3 mana crystals.</Reward>
      <Monster type="52" number="1" level="14" name="Lord of Flame"/>
      <Monster type="42" number="7" level="2"/>
   </Part>
   <Part id="3">
      <Description done="no">You must now take the 3 skulls to the Dragonliche&apos;s resting place. Location: %s.</Description>
      <Description done="yes" first="yes">You have raised the Dragonliche Ghuulgorak to serve you.</Description>
      <Description done="yes" first="no">Alas!  Ghuulgorak&apos;s body could not be found at his resting place.</Description>
      <Success first="yes">You have fought your way to Ghuulgorak&apos;s resting place.</Success>
      <Success first="no">Alas!  Ghuulgorak&apos;s resting place is deserted - it seems sonebody was here before you.</Success>
      <Reward type="allies" unit="34" level="15" number="1" name="Ghuulgorak">You place the 3 skulls on Ghuulgorak&apos;s grave, and he bursts from the ground.</Reward>
