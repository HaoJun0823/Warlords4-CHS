###############################################################################
# Warlords_IV_HOE_106_CH — 换行符策略
###############################################################################
# 默认：源码 / 配置 / 文档按平台习惯规范化
* text=auto

###############################################################################
# 游戏文本与二进制资产：一律 -text（禁止任何换行符转换）
# 理由：游戏按「字节 / 标签」解析文本，CRLF↔LF 改写会破坏索引或引入尾随 \r；
#       且译文必须是 GBK，任何自动转换都可能引入非法字节。
###############################################################################
*.xml  -text
*.nam  -text
*.evt  -text
*.qst  -text
*.txt  -text
*.ini  -text
*.wav  -text
*.tga  -text
*.png  -text
*.ttf  -text
