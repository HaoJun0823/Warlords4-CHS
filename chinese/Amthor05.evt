		<Message>你击败了一名神圣的执政天使，|从尚有余温的遗体中割下心脏。</Message>
		<Monster type="4" number="1" level="15"/>
		<Reward type="xp" data="40"/>
	</Ruin >

	<Event side="0" repeat="1" location="ruin" locdata="18">
