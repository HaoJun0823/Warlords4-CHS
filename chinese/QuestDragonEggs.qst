<Quest name="The Dragon Eggs">
   <Part id="0">
      <Description done="no">Elves have stolen four Dragon eggs from the ancient Dragon, Embrexa.  You will be rewarded for their return. Begin by finding the first egg. Location: %s.</Description>
      <Description done="yes" first="yes">The guardians of the first egg were slain, and egg recovered still intact.</Description>
      <Description done="yes" first="no">The guardians of the first egg were already dead, but you recovered the egg unharmed.</Description>
      <Success first="yes">You have slain the guardians of the first egg and recovered the egg unharmed.</Success>
      <Success first="no">The guardians of the first egg are already dead but fortunately the egg is unharmed.</Success>
      <Reward type="item" data="59">As well as the egg, you also discover a suit of Elven Mail.</Reward>
      <Monster type="59" number="1" level="5" name="Thelena"/>
      <Monster type="56" number="2" level="3"/>
      <Monster type="54" number="3" level="1"/>
   </Part>
   <Part id="1">
      <Description done="no">You must now seek the second dragon egg. Location: %s.</Description>
      <Description done="yes" first="yes">The guardians of the second egg were slain, and egg recovered still intact.</Description>
      <Description done="yes" first="no">The guardians of the second egg were already dead, but you recovered the egg unharmed.</Description>
      <Success first="yes">You have slain the guardians of the second egg and recovered the egg unharmed.</Success>
      <Success first="no">The guardians of the second egg are already dead but fortunately the egg is unharmed.</Success>
      <Reward type="xp" data="10">As well as the egg, you also discover an Elven Potion of Wisdom: +10 Experience.</Reward>
      <Monster type="59" number="1" level="6" name="Belthera"/>
      <Monster type="57" number="5" level="3"/>
   </Part>
   <Part id="2">
      <Description done="no">You must now seek the third dragon egg. Location: %s.</Description>
      <Description done="yes" first="yes">The guardians of the third egg were slain, and egg recovered still intact.</Description>
      <Description done="yes" first="no">The guardians of the third egg were already dead, but you recovered the egg unharmed.</Description>
      <Success first="yes">You have slain the guardians of the third egg and recovered the egg unharmed.</Success>
      <Success first="no">The guardians of third egg are already dead but fortunately the egg is unharmed.</Success>
      <Reward type="allies" unit="12" level="6" number="8">Impressed by the way you slew these Elves, a group of Dwarven Axemen offer to join you.</Reward>
      <Monster type="59" number="1" level="8" name="Yealla"/>
      <Monster type="54" number="7" level="4"/>
   </Part>
   <Part id="3">
      <Description done="no">You must now seek the final dragon egg. This is rumored to be guarded by a fierce group of Treants. Location: %s.</Description>
      <Description done="yes" first="yes">All of the eggs were recovered and out of gratitude, Embrexa the Dragon offered to join you.</Description>
      <Description done="yes" first="no">Unfortunately the resting place of the final egg was empty, and the egg was nowhere to be found.</Description>
      <Success first="yes">You have slain the guardians of the final egg and recovered the egg unharmed.</Success>
      <Success first="no">Unfortunately the resting place of the final egg is empty, and the egg is nowhere to be found.</Success>
      <Reward type="allies" unit="50" level="8" number="1" name="Embrexa">Embrexa the Dragon, overjoyed at the safe return of her eggs, offers to fight alongside you.</Reward>
      <Monster type="58" number="6" level="8"/>
   </Part>
</Quest>
