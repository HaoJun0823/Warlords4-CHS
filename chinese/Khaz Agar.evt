<Events>

	<Warlord side="1" name="King Agarikh XVIII" city="Khaz Agar" portrait="16" major="2" minor="2">
		<Unit id="0" type="17" level="15" name="Khorith"/>
		<Unit id="1" type="17" level="12" name="Jhenith"/>
		<Unit id="2" type="28" level="10" name="Iryx"/>
	</Warlord>


	<Event side="0" repeat="1">
		<Trigger type="turn" data1="1"/>
		<Message>你必须沿着山脉向东进军，击败矮人守卫，直到找到卡兹·阿加尔的堡垒。|洗劫卡兹·阿加尔之后，你便能把财宝带回去献给凯尔图拉克斯。</Message>
	</Event>

	<Event side="0" repeat="1">
		<Trigger type="turn" data1="2"/>
		<Message>一名矮人炼金术士前来求见，似乎完全没有察觉你正准备进攻卡兹·阿加尔。|他提出，只要你愿意在首都为他提供庇护，他就会替你打造魔法物品。</Message>
	</Event>


	<Event side="0" repeat="1" location="capital">
		<Trigger type="turn" data1="5"/>
		<Message>矮人炼金术士完成了一件魔法物品！|他献上一顶明视之盔（首都中的任意英雄都可以领取）。</Message>
		<Action type="item" data1="2"/>
	</Event>
	<Event side="0" repeat="1" location="capital">
		<Trigger type="turn" data1="10"/>
		<Message>矮人炼金术士又完成了一件魔法物品！|他献上一柄恶意战斧（首都中的任意英雄都可以领取）。</Message>
		<Action type="item" data1="27"/>
	</Event>
	<Event side="0" repeat="1" location="capital">
		<Trigger type="turn" data1="15"/>
		<Message>矮人炼金术士又完成了一件魔法物品！|他献上一套矮人锁甲（首都中的任意英雄都可以领取）。</Message>
		<Action type="item" data1="58"/>
	</Event>
	<Event side="0" repeat="1" location="capital">
		<Trigger type="turn" data1="20"/>
		<Message>矮人炼金术士又完成了一件魔法物品！|他献上一枚嘲讽指环（首都中的任意英雄都可以领取）。</Message>
		<Action type="item" data1="89"/>
	</Event>
	<Event side="0" repeat="1">
		<Trigger type="turn" data1="25"/>
		<Message>矮人炼金术士前来求见。|这次他没带来物品，却告诉你一项新发现：凭借它，他能打造一柄威力强大的风暴之刃。不过，恐怕还需要些时日。</Message>
	</Event>
	<Event side="0" repeat="1" location="capital">
		<Trigger type="turn" data1="30"/>
		<Message>矮人炼金术士终于完成了风暴之刃，并将它作为最后一件作品赠予你。</Message>
		<Action type="item" data1="48"/>
	</Event>


	<Ruin id="23" available_for_quest="no">
		<Heading>魔像守卫</Heading>
		<Message>这尊魔像守护着一大堆矮人的财宝。</Message>
		<Monster type="14" number="1" level="10"/>
		<Reward type="gold" data="3241"/>
	</Ruin>
	<Ruin id="19" available_for_quest="no">
		<Heading>魔像守卫</Heading>
		<Message>这尊魔像守护着一柄矮人魔法宝剑。</Message>
		<Monster type="14" number="1" level="10"/>
		<Reward type="item" data="25"/>
	</Ruin>
	<Ruin id="17" available_for_quest="no">
		<Heading>魔像守卫</Heading>
		<Message>这尊魔像看守着一名精灵俘虏。获救后，他心怀感激，愿意加入你的队伍。</Message>
		<Monster type="14" number="1" level="10"/>
		<Reward type="allies" data="54" level="15" number="1" name="Prince Delfen"/>
	</Ruin>

</Events>
