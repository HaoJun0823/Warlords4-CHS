<Events>
    <!--Campaign: Amthor. Created by Sil taTener-->
	<Warlord side="1" name="Haunter" city="Agaril" level="5" portrait="27" major="2" minor="0">
		<Unit id="0" type="12" level="12" name="Huntsman"/>
		<Unit id="1" type="12" level="12" name="Huntsman"/>
		<Unit id="2" type="12" level="16" name="Huntsman"/>
	</Warlord>

	<Warlord side="2" name="Altorden" city="Pamir" level="5" portrait="22" major="0" minor="0">
	</Warlord>

	<Event side="0" repeat="1">
		<Trigger type="on_turn"/>
		<Trigger type="turn" data1="1"/>
		<Message string1="dummy" string2="English\\Sounds\\Amthor\\intro01.wav">你终于抵达白色山脉的边缘。只有寥寥几名战士跟随你逃入这座小村。你的兄弟姐妹全都死了……死在卡兹·阿加尔那些幽魂手中。|你正坐在炉火旁，一名卫兵突然出现在门口，通报说希安特拉求见——一个精灵。精灵竟敢踏进你的家门？你伸手去抓法杖，指尖却骤然传来一阵电击。刹那间，电光弥漫了整个房间。一位美丽的年轻女子忽然站在你面前。|“向你致意，阿姆索尔领主，乌斯纳格一族最后的子嗣……”</Message>
		<Message>她用深色的眼眸打量着你。|“我来是想与你结盟。我们算不上朋友，却有同一个敌人——卡兹·阿加尔。”|你正要打断她，她只打了个响指便阻止了你。|“回答之前，最好先看清眼下的处境。这是你最后的机会……”|你知道她说得没错，只能咬紧牙关，答应结盟。|她唇边掠过一丝笑意：“我就知道，我们会相处得很愉快……去南方的特里尔福德吧，你会在那里得到所需的支援。”|说完，她一言不发地离开了房间。</Message>
		<Action type="unit" data1="12" data2="3" data3="3"/>
	</Event>

    <!--Reinforcement Quest-->
	<Event side="0" repeat="99" location="city" locdata="5">
		<Trigger type="on_turn"/>
		<Trigger type="chance" data1="20"/>
		<Trigger type="counter_ge" data1="1" String1="reinforcement"/>
		<Action type="counter_add" data1="1" String1="reinforcement"/>
	</Event>

	<Event side="0" repeat="99" location="city" locdata="5">
		<Trigger type="on_turn"/>
		<Trigger type="counter_eq" data1="3" String1="reinforcement"/>
		<ShortMessage>一只鹰身女妖抵达特里尔福德。</ShortMessage>
		<Action type="unit" data1="40" data2="1" data3="3"/>
		<Action type="counter_add" data1="1" String1="reinforcement"/>
	</Event>

	<Event side="0" repeat="99" location="city" locdata="5">
		<Trigger type="on_turn"/>
		<Trigger type="counter_eq" data1="2" String1="reinforcement"/>
		<ShortMessage>一群蜘蛛抵达特里尔福德。</ShortMessage>
		<Action type="unit" data1="36" data2="2" data3="2"/>
		<Action type="counter_add" data1="1" String1="reinforcement"/>
	</Event>

	<Event side="0" repeat="99" location="city" locdata="5">
		<Trigger type="on_turn"/>
		<Trigger type="counter_eq" data1="1" String1="reinforcement"/>
		<ShortMessage>一只蜘蛛抵达特里尔福德 1。</ShortMessage>
		<Action type="unit" data1="36" data2="1" data3="4"/>
		<Action type="counter_add" data1="1" String1="reinforcement"/>
	</Event>

	<Event side="0" repeat="99" location="city" locdata="5">
		<Trigger type="on_turn"/>
		<Trigger type="counter_ge" data1="4" String1="reinforcement"/>
		<Action type="counter_add" data1="-3" String1="reinforcement"/>
	</Event>

	<Event side="0" repeat="1" location="city" locdata="5">
		<Trigger type="on_city"/>
		<Trigger type="city_owned" data1="5" data2="0"/>
		<Message>你抵达了特里尔福德城。摄政官前来迎接，并转达希安特拉的消息：她的援军很快便会抵达这里。</Message>
		<Action type="particle" string1="QuestSparkle"/>
		<Action type="counter_set" data1="1" String1="reinforcement"/>
	</Event>

	<Event side="1" repeat="1" location="city" locdata="5">
		<Trigger type="on_city"/>
		<Trigger type="city_won" data1="5"/>
		<Action type="counter_set" data1="10" String1="reinforcement"/>
	</Event>
	<Event side="2" repeat="1" location="city" locdata="5">
		<Trigger type="on_city"/>
		<Trigger type="city_won" data1="5"/>
		<Action type="counter_set" data1="10" String1="reinforcement"/>
	</Event>

    <!--Win Options-->
	<Event side="0" repeat="1" location="capital">
		<Trigger type="on_turn"/>
		<Trigger type="counter_eq" data1="10" String1="reinforcement"/>
		<Message>补给城市落入敌人手中。你的任务失败了。</Message>
		<Action type="defeat" data1="0"/>
	</Event>

	<Event side="0" repeat="1" location="city" locdata="20">
		<Trigger type="on_city"/>
		<Trigger type="city_won" data1="20"/>
		<Message>你终于杀死了幽魂首领。|接下来进入《阿姆索尔 02》……</Message>
		<Action type="victory" data1="0"/>
	</Event>

</Events>
