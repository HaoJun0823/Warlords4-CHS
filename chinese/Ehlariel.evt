<Events>

	<Warlord side="1" name="The Ice Queen" city="Citadel of Ice" portrait="12" major="1" minor="3">
		<Unit id="0" type="59" level="12" name="Thelena"/>
		<Unit id="1" type="50" level="8" name="Lightning"/>
		<Unit id="2" type="54" level="20" name="Tolen"/>
	</Warlord>


	<Event side="0" repeat="1">
		<Trigger type="turn" data1="1"/>
		<Message>The Citadel of Ice is found to the west, in the center of the Northern Tundra. | You must capture the citadel and find the lost counterspell of Queen Ehlanna.</Message>
	</Event>

	<Event side="0" repeat="1">
		<Trigger type="turn" data1="2"/>
		<Message>You have found an old book that tells you of the Orbs of Winter. | These 5 Orbs contain the souls of old High Elven mages. There are 4 smaller Orbs and one Master Orb.</Message>
	</Event>

	<Ruin id="14" available_for_quest="no">
		<Heading>Orb of Winter</Heading>
		<Message>You find one of the legendary Orbs of Winter. You smash it, releasing a storm onto the Northern Tundra.</Message>
		<Monster type="54" number="8" level="5"/>
		<Reward type="xp" data="10"/>
	</Ruin >
